[sub_resource type="GDScript" id="GDScript_u6okd"]
script/source = "extends Node2D
func _ready() -> void:
	$RicherTextLabel.link_clicked.connect(func(e): print(\"Cicked \", e))
	$RicherTextLabel.link_hovered.connect(func(e): print(\"Hovered \", e))
	$RicherTextLabel.link_unhovered.connect(func(e): print(\"UnHovered \", e))
	$RicherTextLabel.link_right_clicked.connect(func(e): print(\"Right Cicked \", e))
	
"

